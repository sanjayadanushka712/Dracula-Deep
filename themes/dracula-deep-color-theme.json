  "tokenColors": [
    {
      "settings": {
        "foreground": "#A8A8A8"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6B6B6B",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.unquoted",
        "string.template",
        "constant.other.symbol",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#7FAFA5"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character.escape",
        "support.constant",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#8B9E86"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#9C8CC0"
      }
    },
    {
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#9C8CC0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name",
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "entity.name.namespace",
        "support.other.namespace"
      ],
      "settings": {
        "foreground": "#B2AE7C"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "entity.name.tag.html"
      ],
      "settings": {
        "foreground": "#C08FA8"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable",
        "support.other.variable",
        "variable.other.readwrite",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#C0CAD4"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#9C8CC0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "variable.parameter.function"
      ],
      "settings": {
        "foreground": "#9FB0C0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "variable.other.object.property",
        "meta.object.member",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#8FA8C4"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#6FA5B0"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call",
        "meta.function-call.generic",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#B99A6E"
      }
    },
    {
      "scope": [
        "entity.name.method",
        "meta.method.declaration",
        "meta.class-method"
      ],
      "settings": {
        "foreground": "#C9A87C"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "constant.other.reference",
        "markup.underline.link.url"
      ],
      "settings": {
        "foreground": "#8FA8C4",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal",
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#D98080"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "markup.changed"
      ],
      "settings": {
        "foreground": "#7FAFA5"
      }
    },
    {
      "scope": [
        "meta.brace",
        "meta.delimiter",
        "punctuation.section.block",
        "punctuation.section.brackets",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "meta.objectliteral",
        "punctuation.separator.objectvalue",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#7E8C99"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator",
        "punctuation.definition.parameters"
      ],
      "settings": {
        "foreground": "#8A98A6"
      }
    }
  ]
}
